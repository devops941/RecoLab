# Environment variables template for RecoLab Backend

# Application Settings
APP_NAME=RecoLab
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Server URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/recolab_db?retryWrites=true&w=majority
MONGODB_DB_NAME=recolab_db

# JWT & Security
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# File & Artifact Storage Directories
UPLOAD_DIRECTORY=./uploads
MODEL_STORAGE_DIRECTORY=./models_storage
REPORTS_DIRECTORY=./reports_storage

# Recommendation & ML Engine Defaults
DEFAULT_SIMILARITY_THRESHOLD=0.15
DEFAULT_TOP_K=10
DEFAULT_CONTENT_WEIGHT=0.5
DEFAULT_INTERACTION_WEIGHT=0.5
TFIDF_MAX_FEATURES=5000
